<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema claro fixo: as cores do app são definidas para fundo claro -->
    <style name="Base.Theme.BibliotecaPessoal" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorOnPrimary">@color/cor_texto_cabecalho</item>
        <item name="colorPrimaryContainer">@color/cor_primaria_clara</item>
        <item name="colorOnPrimaryContainer">@color/cor_primaria</item>
        <!-- Indicador do item ativo no menu inferior -->
        <item name="colorSecondaryContainer">@color/cor_primaria_clara</item>
        <item name="colorOnSecondaryContainer">@color/cor_primaria</item>
        <item name="colorSurface">@color/cor_superficie</item>
        <item name="colorOnSurface">@color/cor_texto_primario</item>
        <item name="colorOutline">@color/cor_divisor</item>
        <item name="android:colorBackground">@color/cor_fundo</item>
        <item name="android:windowBackground">@color/cor_fundo</item>
        <!-- Tipografia: estilos padrão de botão, checkbox e menu inferior -->
        <item name="materialButtonStyle">@style/Botao.Principal</item>
        <item name="bottomNavigationStyle">@style/MenuInferior</item>
        <item name="checkboxStyle">@style/Caixa.Lido</item>
    </style>

    <!-- Tipografia só com fontes do sistema: serifa nos títulos (clima de livro), Roboto no resto -->
    <style name="Texto.Cabecalho" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/cor_texto_primario</item>
    </style>

    <style name="Texto.TituloLivro" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/cor_texto_primario</item>
    </style>

    <style name="Texto.Secundario" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/cor_texto_secundario</item>
    </style>

    <!-- Tag em caixa alta com espaçamento: lê melhor em tamanho pequeno -->
    <style name="Texto.Tag" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Texto.ResumoTotal" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Texto.ResumoItem" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Botao.Principal" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Caixa.Lido" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Barra de tabs: cartão branco com cantos superiores arredondados e sombra suave -->
    <style name="MenuInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/cor_superficie</item>
        <item name="elevation">16dp</item>
        <item name="shapeAppearance">@style/Forma.MenuInferior</item>
        <item name="itemPaddingTop">14dp</item>
        <item name="itemPaddingBottom">14dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/Texto.MenuAtivo</item>
        <item name="itemTextAppearanceInactive">@style/Texto.MenuInativo</item>
        <item name="itemActiveIndicatorStyle">@style/Indicador.MenuInferior</item>
        <item name="materialThemeOverlay">@style/Overlay.MenuInferior</item>
    </style>

    <style name="Forma.MenuInferior" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Pílula do item ativo, um pouco mais larga que o padrão -->
    <style name="Indicador.MenuInferior" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">72dp</item>
        <item name="android:height">34dp</item>
        <item name="android:color">@color/cor_primaria_clara</item>
    </style>

    <!-- Ativo na cor da marca, inativo em cinza; sem o tom lilás da elevação -->
    <style name="Overlay.MenuInferior" parent="">
        <item name="colorOnSecondaryContainer">@color/cor_primaria</item>
        <item name="colorOnSurface">@color/cor_primaria</item>
        <item name="colorOnSurfaceVariant">@color/cor_texto_secundario</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainer">@color/cor_superficie</item>
    </style>

    <style name="Texto.MenuAtivo" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Texto.MenuInativo" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Theme.BibliotecaPessoal" parent="Base.Theme.BibliotecaPessoal" />
</resources>
